    classDef domain fill:#fff4e6,stroke:#f08c00,stroke-width:1px,color:#111;
    classDef dro fill:#fff0f6,stroke:#d6336c,stroke-width:1px,color:#111;
    classDef out fill:#eafaf1,stroke:#2f9e44,stroke-width:1px,color:#111;

    class A,B data;
    class C,D,E,F,G domain;
    class H,I,J,K,L dro;
    class M out;
